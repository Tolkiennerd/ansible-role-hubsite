html {
    background-color: #2b2b2b;
    color: lightgreen;
    font-weight: 300;
    line-height: 1;
    text-rendering: optimizeLegibility;
    font-size: 1.5rem;
    font-family: Helvetica, sans-serif
}

@media (max-width:1000px){
    html{
        font-size: 36px;
    }
}

body {
    max-width: 50rem;
    margin-left: auto;
    margin-right: auto;
}

h1 {
    font-size: 3rem;
    text-align: center;
}

body > div > div {
    height: 45vh;
}

body > div > div:nth-child(2) {
    text-align: center;
}

img {
    height: 40vh;
}

@media screen and (prefers-color-scheme: light) {
    html {
        background-color: #f1f1f1;
        color: darkgreen;
    }

    img {
        height: initial;
        width: 90vw;
    }
}